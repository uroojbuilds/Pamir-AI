SECRET_KEY=

# Qwen3 (Alibaba Cloud Model Studio / DashScope) reasoning integration.
# Leave blank in development if you don't have a key yet - the backend will
# run fine without it and /api/business-analysis will report qwen_status:
# "not_configured" instead of using Qwen. Never commit a real value here.
DASHSCOPE_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=

# Alibaba Accio sourcing/discovery integration.
# NOTE: no official Accio API documentation exists in this project yet, so
# these variable names are placeholders for consistency with the rest of the
# app - they are NOT confirmed against real Accio documentation. Rename them
# if the official docs specify different names once they're available.
# Leave blank until real credentials/docs are provided - the backend runs
# fine without them and /api/opportunity will report accio_status:
# "not_configured" and continue serving local dataset results.
ACCIO_API_KEY=
ACCIO_BASE_URL=

# Alibaba Wanx 2.1 marketing-asset integration.
# NOTE: no official Wanx API documentation exists in this project yet, so
# these variable names are placeholders for consistency with the rest of the
# app - they are NOT confirmed against real Wanx documentation. Rename them
# if the official docs specify different names once they're available.
# Leave blank until real credentials/docs are provided - the backend runs
# fine without them and /api/marketing (and /api/launch-kit) will report
# wanx_status: "not_configured" and continue serving local template content.
WANX_API_KEY=
WANX_BASE_URL=

